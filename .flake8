[flake8]
# Flake8 configuration for LUXORliving
max-line-length = 100
extend-ignore = E203, E266, E501, W503
exclude = 
    .git,
    __pycache__,
    .venv,
    venv,
    .eggs,
    *.egg,
    build,
    dist,
    .tox,
    .mypy_cache
per-file-ignores =
    __init__.py:F401,F403
    tests/*:F401,F811,E501
